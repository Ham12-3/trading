# Copy to .env and fill in. Never commit .env.

# Postgres (used by docker compose and the backend)
POSTGRES_USER=newsalpha
POSTGRES_PASSWORD=newsalpha
POSTGRES_DB=newsalpha
DATABASE_URL=postgresql+psycopg://newsalpha:newsalpha@localhost:5432/newsalpha

# Anthropic (Phase 2+)
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent: "Name email@example.com" (Phase 1+)
SEC_USER_AGENT_NAME=
SEC_USER_AGENT_EMAIL=

# Frontend -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional overrides (defaults shown)
# DATA_DIR=data
# SEC_MAX_REQUESTS_PER_SECOND=5

# OpenAI (Phase 2 extraction; models and prices in backend/config/models.yaml)
OPENAI_API_KEY=
